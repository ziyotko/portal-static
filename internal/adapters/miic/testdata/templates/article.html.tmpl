<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{.Article.Summary}}">
  <title>{{.Article.Title}} - 机械工业信息中心</title>
  <link rel="icon" type="image/png" href="{{.RootPrefix}}assets/miic-favicon.png">
  <link rel="stylesheet" href="{{.RootPrefix}}styles.css">
</head>
<body data-page="article" data-active-root="{{.ActiveRoot}}" data-root-prefix="{{.RootPrefix}}" data-generated-at="{{.GeneratedAt}}">
  <header class="site-header" id="site-header"></header>
  <main>
    <section class="page-hero important-carousel" data-important-carousel aria-label="中心重要动态"></section>
    <section class="page-content article-page-content"><div class="shell detail-layout article-detail-layout has-related">
      <article class="detail-article static-article" data-static-article>
        <header class="article-header">
          <nav class="article-breadcrumb" aria-label="当前位置"><a href="{{.BackHref}}">{{.BackLabel}}</a><span aria-hidden="true">/</span><span>{{.Column.Name}}</span></nav>
          <h1>{{.Article.Title}}</h1>
          {{if .Article.Summary}}<p class="article-deck">{{.Article.Summary}}</p>{{end}}
          <div class="article-meta"><span>来源：{{if .Article.Source}}{{.Article.Source}}{{else}}机械工业信息中心{{end}}</span><time>{{.Article.DateCN}}</time></div>
        </header>
        <div class="static-article__content">{{.Article.Content}}</div>
      </article>
      <aside class="article-related" aria-labelledby="article-related-title">
        <h2 id="article-related-title">相关资讯</h2>
        <ul>
          {{range .Related}}<li><a href="{{.Href}}"{{if .External}} target="_blank" rel="noopener noreferrer"{{end}}><span>{{.Title}}</span><time datetime="{{.DateISO}}">{{.DateDot}}</time></a></li>{{else}}<li class="article-related-empty">该栏目暂无其他资讯</li>{{end}}
        </ul>
      </aside>
    </div></section>
  </main>
  <footer class="site-footer" id="site-footer"></footer>
  <script src="{{.RootPrefix}}generated-content.js"></script>
  <script src="{{.RootPrefix}}script.js"></script>
</body>
</html>
