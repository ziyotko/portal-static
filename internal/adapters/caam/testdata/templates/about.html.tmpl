<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="中国汽车工业协会简介、领导团队、组织机构、协会章程、主要职责与协会荣誉。">
  <title>协会概况 - 中国汽车工业协会</title>
  <link rel="stylesheet" href="css/style.css?v=20260805-21">
  <link rel="stylesheet" href="css/design-pages.css?v=20260810-2">
</head>
<body class="about-page" data-generated-at="{{.GeneratedAt}}">
  <header class="site-header">
    <div class="header-visual" aria-label="中国汽车工业协会">
      <div class="container header-branding">
        <img class="header-rating-image" src="assets/slice/header-rating@2x.png" alt="中国社会组织评估等级 AAAAA">
        <img class="header-logo-image" src="assets/slice/header-logo@2x.png" alt="中国汽车工业协会">
        <img class="header-slogan-image" src="assets/slice/header-slogan@2x.png" alt="求真、务实、创新、高效">
      </div>
      <div class="container header-tools"><div class="lang" aria-label="语言切换"><strong>中文</strong><span>|</span><a href="https://www.caam.org.cn/english">English</a></div></div>
    </div>
    <nav class="main-nav" aria-label="主导航">
      <div class="container nav-inner">
        <a href="index.html">首页</a>
        <a class="active" href="about.html" aria-current="page">协会概况</a>
        <a href="work.html">协会工作</a>
        <a href="stats.html">统计数据</a>
        <a href="members.html">会员专区</a>
        <a class="party" href="party.html">党建专区</a>
      </div>
    </nav>
  </header>

  <main>
    <section class="about-intro" id="intro">
      <div class="container about-intro-grid">
        <div class="about-mark"><img src="assets/slice/logo.png" alt="中国汽车工业协会"></div>
        <div class="about-copy">{{.Intro}}</div>
      </div>
    </section>

    <section class="leadership-section" id="leadership" aria-labelledby="leadership-title">
      <div class="container">
        <header class="leadership-heading"><h2 id="leadership-title">领导团队</h2></header>
        {{if .Leaders}}
        <div class="leadership-grid" aria-label="领导团队成员">
          {{range .Leaders}}
          <a class="leader-card" href="{{.Href}}" aria-label="{{.Name}}{{if .Role}}，{{.Role}}{{end}}"{{if .ExternalLink}} target="_blank" rel="noopener noreferrer"{{end}}>
            <div class="leader-card-copy">
              <h3{{if .Bold}} class="is-bold"{{end}}{{if .Color}} style="color:{{.Color}}"{{end}}>{{.Name}}</h3>
              {{if .Role}}<p>{{.Role}}</p>{{end}}
            </div>
          </a>
          {{end}}
        </div>
        {{else}}<p class="about-empty">暂无内容</p>{{end}}
      </div>
    </section>

    <section class="member-unit-section" id="member-units" aria-labelledby="member-units-title">
      <div class="container">
        <h2 id="member-units-title">会员单位</h2>
        <div class="member-unit-grid">
          {{range .Members}}{{if .Href}}<a class="unit-card" href="{{.Href}}"><strong>{{.Title}}</strong><span>查看更多 ⊙</span></a>{{else}}<div class="unit-card is-disabled"><strong>{{.Title}}</strong><span>暂无内容</span></div>{{end}}{{end}}
        </div>
      </div>
    </section>

    <section class="about-details" id="about-details">
      <div class="container about-detail-grid">
        <section class="detail-group compact" id="charter">
          <h2>协会章程</h2><div class="detail-list">{{range .Charter}}<a href="{{.Href}}"{{if .ExternalLink}} target="_blank" rel="noopener noreferrer"{{end}}{{if .Bold}} class="is-bold"{{end}}{{if .Color}} style="color:{{.Color}}"{{end}}><span class="detail-title" title="{{.Title}}">{{.Title}}</span></a>{{else}}<span class="about-empty">暂无内容</span>{{end}}</div>
        </section>
        <section class="detail-group compact" id="responsibilities">
          <h2>主要职责</h2><div class="detail-list">{{range .Responsibilities}}<a href="{{.Href}}"{{if .ExternalLink}} target="_blank" rel="noopener noreferrer"{{end}}{{if .Bold}} class="is-bold"{{end}}{{if .Color}} style="color:{{.Color}}"{{end}}><span class="detail-title" title="{{.Title}}">{{.Title}}</span></a>{{else}}<span class="about-empty">暂无内容</span>{{end}}</div>
        </section>
        <section class="detail-group organization wide" id="organization">
          <h2>组织机构</h2>{{if .Organization}}<div class="honor-columns">{{range .OrganizationCols}}<div class="detail-list">{{range .}}<a href="{{.Href}}"{{if .ExternalLink}} target="_blank" rel="noopener noreferrer"{{end}}{{if .Bold}} class="is-bold"{{end}}{{if .Color}} style="color:{{.Color}}"{{end}}><span class="detail-title" title="{{.Title}}">{{.Title}}</span></a>{{end}}</div>{{end}}</div>{{else}}<span class="about-empty">暂无内容</span>{{end}}
        </section>
        <section class="detail-group honors wide" id="honors">
          <h2>协会荣誉</h2>{{if .Honors}}<div class="honor-columns">{{range .HonorCols}}<div class="detail-list">{{range .}}<a href="{{.Href}}"{{if .ExternalLink}} target="_blank" rel="noopener noreferrer"{{end}}{{if .Bold}} class="is-bold"{{end}}{{if .Color}} style="color:{{.Color}}"{{end}}><span class="detail-title" title="{{.Title}}">{{.Title}}</span></a>{{end}}</div>{{end}}</div>{{else}}<span class="about-empty">暂无内容</span>{{end}}
        </section>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-main">
      <div class="footer-top">
        <img class="footer-logo" src="assets/slice/logo.png" alt="中国汽车工业协会">
        <div class="footer-selects">
          {{range .FooterLinks}}<label class="footer-link-select"><select data-footer-link aria-label="{{.Title}}"{{if not .Items}} disabled{{end}}><option value="" selected disabled hidden>{{.Title}}</option>{{range .Items}}<option value="{{.Href}}">{{.Title}}</option>{{end}}</select></label>{{end}}
        </div>
        <div class="qr"><span role="img" aria-label="中国汽车工业协会微信公众号二维码"></span></div>
      </div>
      <div class="footer-info"><p>地址：北京市丰台区汽车博物馆东路诺德中心11号楼33层</p><p>电话：010-63979900 | E-mail:caam@caam.org.cn | 邮编：100160</p><p class="qr-labels"><span>微信公众号</span></p></div>
    </div>
    <div class="copyright"><div class="container copyright-inner"><span>Copyright© 中国汽车工业协会 | 京ICP备05030302-7 | 京公网安备 11010602014012号</span><span>关于我们 | 联系方式 | 服务内容 | 广告刊例 | 网站地图</span></div></div>
  </footer>
  <script src="js/design-pages.js?v=20260803-1"></script>
</body>
</html>
