{{define "list"}}{{template "head" .}}<main class="page-shell{{if eq .ActiveNav "党建专栏"}} party-theme{{end}}"><div class="page-inner">{{template "breadcrumb" .}}<div class="content-grid">{{template "sidebar" .}}<section>{{if or (eq .ColumnCode "videos") (eq .ColumnCode "videos-news")}}<div class="video-grid-card"><div class="video-grid">{{range .Items}}<article class="video-card searchable"><div class="video-thumb"><img src="{{root $ .Cover}}" alt="{{.Title}}"><a class="play-button" href="{{root $ .Href}}?from={{.ColumnCode}}" aria-label="进入视频详情页播放"></a></div><h2><a href="{{root $ .Href}}?from={{.ColumnCode}}">{{.Title}}</a></h2><p>{{.Summary}}</p><footer><time>{{.Date}}</time><a href="{{root $ .Href}}?from={{.ColumnCode}}">查看详情 →</a></footer></article>{{else}}<p>暂无公开内容</p>{{end}}</div></div>{{else}}<div class="list-card"><ul class="news-list">{{range .Items}}<li class="news-row searchable"><a href="{{root $ .Href}}?from={{.ColumnCode}}">{{.Title}}</a><time>{{.Date}}</time></li>{{else}}<li class="news-row">暂无公开内容</li>{{end}}</ul></div>{{end}}{{template "pagination" .}}</section></div></div></main>{{template "foot" .}}{{end}}
{{define "pagination"}}<div class="pagination-wrap"><span>共 {{.Total}} 项数据</span><nav class="pagination" aria-label="分页">{{if .Previous}}<a class="plain" href="{{root . .Previous}}" aria-label="上一页">‹</a>{{else}}<span class="plain disabled" aria-hidden="true">‹</span>{{end}}{{range .Pages}}{{if .Number}}<a class="page-number {{if .Active}}active{{end}}" href="{{root $ .Href}}"{{if .Active}} aria-current="page"{{end}}>{{.Number}}</a>{{else}}<span class="ellipsis" aria-hidden="true">…</span>{{end}}{{end}}{{if .Next}}<a class="plain" href="{{root . .Next}}" aria-label="下一页">›</a>{{else}}<span class="plain disabled" aria-hidden="true">›</span>{{end}}</nav><label class="page-jump">跳至 <input type="number" min="1" max="{{.TotalPages}}" value="{{.Page}}" data-page-prefix="{{root . .PagePrefix}}" aria-label="跳转页码"> /{{.TotalPages}} 页</label></div>{{end}}
{{define "search"}}{{template "head" .}}<main class="page-shell" data-search-page><div class="page-inner">{{template "breadcrumb" .}}<section class="list-card"><h1>站内搜索</h1><form class="search-page-form"><input name="q" type="search" placeholder="请输入关键词"><button type="submit">搜索</button></form><p data-search-summary>请输入关键词进行搜索</p><ul class="news-list">{{range .Items}}<li class="news-row" data-search-result hidden><a href="{{root $ .Href}}?from={{.ColumnCode}}">{{.Title}}</a><time>{{.Date}}</time></li>{{end}}</ul><p data-search-empty hidden>未找到相关内容</p><div data-search-pagination hidden><span data-search-pages></span></div></section></div></main>{{template "foot" .}}{{end}}
{{define "member-shell"}}{{template "head" .}}<main class="page-shell"><div class="page-inner">{{template "breadcrumb" .}}<section class="list-card" data-member-list-shell data-column-code="member"><h1>会员中心</h1><p>会员栏目将在登录并通过权限校验后加载。</p></section></div></main>{{template "foot" .}}{{end}}
{{define "member-detail-shell"}}{{template "head" .}}<main class="page-shell"><div class="page-inner">{{template "breadcrumb" .}}<article class="article-card" data-member-detail-shell><h1>会员内容</h1><p>请登录后查看会员内容。</p></article></div></main>{{template "foot" .}}{{end}}
