{{define "list"}}{{template "head" .}}<main class="page-shell{{if eq .ActiveNav "党建专栏"}} party-theme{{end}}"><div class="page-inner">{{template "breadcrumb" .}}<div class="content-grid">{{template "sidebar" .}}<section>{{if or (eq .ColumnCode "videos") (eq .ColumnCode "videos-news")}}<div class="video-grid-card"><div class="video-grid">{{range .Items}}<article class="video-card searchable"><div class="video-thumb"><img src="{{root $ .Cover}}" alt="{{.Title}}"><a class="play-button" href="{{root $ .Href}}?from={{.ColumnCode}}" aria-label="进入视频详情页播放"></a></div><h2><a href="{{root $ .Href}}?from={{.ColumnCode}}">{{.Title}}</a></h2><p>{{.Summary}}</p><footer><time>{{.Date}}</time><a href="{{root $ .Href}}?from={{.ColumnCode}}">查看详情 →</a></footer></article>{{else}}<p>暂无公开内容</p>{{end}}</div></div>{{else}}<div class="list-card"><ul class="news-list">{{range .Items}}<li class="news-row searchable"><a href="{{root $ .Href}}?from={{.ColumnCode}}">{{.Title}}</a><time>{{.Date}}</time></li>{{else}}<li class="news-row">暂无公开内容</li>{{end}}</ul></div>{{end}}{{template "pagination" .}}</section></div></div></main>{{template "foot" .}}{{end}}
{{define "pagination"}}<div class="pagination-wrap"><span>共 {{.Total}} 项数据</span><nav class="pagination" aria-label="分页">{{if .Previous}}<a class="plain" href="{{root . .Previous}}" aria-label="上一页">‹</a>{{else}}<span class="plain disabled" aria-hidden="true">‹</span>{{end}}{{range .Pages}}{{if .Number}}<a class="page-number {{if .Active}}active{{end}}" href="{{root $ .Href}}"{{if .Active}} aria-current="page"{{end}}>{{.Number}}</a>{{else}}<span class="ellipsis" aria-hidden="true">…</span>{{end}}{{end}}{{if .Next}}<a class="plain" href="{{root . .Next}}" aria-label="下一页">›</a>{{else}}<span class="plain disabled" aria-hidden="true">›</span>{{end}}</nav><label class="page-jump">跳至 <input type="number" min="1" max="{{.TotalPages}}" value="{{.Page}}" data-page-prefix="{{root . .PagePrefix}}" aria-label="跳转页码"> /{{.TotalPages}} 页</label></div>{{end}}
{{define "search"}}{{template "head" .}}<main class="page-shell search-page" data-search-page><div class="page-inner">{{template "breadcrumb" .}}<section class="search-card"><h1>站内搜索</h1><form class="search-page-form" role="search" action="{{root . "search.html"}}" method="get"><label class="sr-only" for="search-page-input">搜索关键词</label><input id="search-page-input" name="q" type="search" placeholder="请输入关键词" autocomplete="off"><button type="submit">搜索 <span class="search-icon" aria-hidden="true"></span></button></form><p class="search-summary" data-search-summary aria-live="polite">请输入关键词进行搜索</p><ul class="search-result-list">{{range .Items}}<li class="search-result-item" data-search-result hidden><a href="{{root $ .Href}}?from={{.ColumnCode}}"><h2>{{.Title}}</h2><p>{{.Summary}}</p><div class="search-result-meta"><span>{{.Category}}</span><time datetime="{{.Date}}">{{.Date}}</time></div></a></li>{{end}}</ul><div class="search-empty" data-search-empty hidden><strong>未找到相关内容</strong><p>请尝试缩短关键词，或更换其他关键词重新搜索。</p></div><nav class="search-pagination pagination" data-search-pagination aria-label="搜索结果分页" hidden><button class="plain" type="button" data-search-prev aria-label="上一页">‹</button><span data-search-pages></span><button class="plain" type="button" data-search-next aria-label="下一页">›</button></nav></section></div></main>{{template "foot" .}}{{end}}
{{define "member-shell"}}{{template "head" .}}<main class="page-shell member-page" data-member-list-shell><div class="page-inner"><nav class="breadcrumb" aria-label="面包屑"><ol data-member-breadcrumb><li><a href="../index.html">首页</a></li><li><span aria-current="page">会员中心</span></li></ol></nav><div class="content-grid"><aside aria-label="会员栏目" hidden><ul class="side-menu" data-member-columns></ul></aside><section aria-live="polite"><div class="list-card member-list-card"><h1 data-member-heading>会员中心</h1><div data-member-status role="status">正在核验会员身份…</div><ul class="news-list" data-member-items hidden></ul></div><div class="pagination-wrap" data-member-pagination hidden></div></section></div></div></main>{{template "foot" .}}{{end}}
{{define "member-detail-shell"}}{{template "head" .}}<main class="page-shell member-page" data-member-detail-shell><div class="page-inner"><nav class="breadcrumb" aria-label="面包屑"><ol data-member-breadcrumb><li><a href="../index.html">首页</a></li><li><a href="member.html">会员中心</a></li><li><span aria-current="page">会员内容</span></li></ol></nav><div class="content-grid"><aside aria-label="会员专区"><ul class="side-menu"><li class="is-active"><a href="member.html">会员中心</a></li></ul></aside><article class="article-card member-detail-card" aria-live="polite"><div data-member-status role="status">正在核验会员身份…</div><div data-member-content hidden></div></article></div></div></main>{{template "foot" .}}{{end}}
