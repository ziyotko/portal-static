{{define "article"}}{{template "head" .}}<main class="page-shell" data-detail-page data-default-column-code="{{.ColumnCode}}"><div class="page-inner">{{template "breadcrumb" .}}{{with .Article}}<article class="article-card"><header class="article-header"><h1>{{.Title}}</h1><p><time>{{.Date}}</time>　来源：{{.Source}}</p></header>{{if .Video}}<div class="video-stage">{{if .HasVideo}}{{.Content}}{{else}}<img src="{{root $ .Cover}}" alt="{{.Title}}"><span class="video-play">▶</span>{{end}}</div>{{else}}<div class="article-body">{{.Content}}</div>{{end}}{{if .Attachments}}<section><h2>附件下载</h2>{{range .Attachments}}<a href="{{root $ .URL}}">{{.Name}}</a>{{end}}</section>{{end}}</article>{{end}}<nav class="article-adjacent">{{with .PreviousArticle}}<a href="{{root $ .Href}}?from={{$.ColumnCode}}">上一篇：{{.Title}}</a>{{end}}{{with .NextArticle}}<a href="{{root $ .Href}}?from={{$.ColumnCode}}">下一篇：{{.Title}}</a>{{end}}</nav></div></main>{{template "foot" .}}{{end}}
{{define "empty-detail"}}{{template "head" .}}<main class="page-shell"><div class="page-inner"><section class="article-card"><h1>暂无内容</h1></section></div></main>{{template "foot" .}}{{end}}
