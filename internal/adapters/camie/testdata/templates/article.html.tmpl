{{define "article"}}{{template "head" .}}<main class="page-shell{{if eq .ActiveNav "党建专栏"}} party-theme{{end}}" data-detail-page data-default-column-code="{{.ColumnCode}}"><div class="page-inner">{{template "breadcrumb" .}}<div class="content-grid">{{template "sidebar" .}}{{with .Article}}<article class="article-card{{if .Video}} video-detail-card{{end}}"><header class="article-header"><h1>{{.Title}}</h1><div class="article-meta"><span>{{.Date}}</span><span>{{.Source}}</span></div></header>{{if .Video}}<div class="video-stage">{{if .HasVideo}}{{.Content}}{{else}}<img src="{{root $ .Cover}}" alt="{{.Title}}"><span class="play-button" aria-hidden="true"></span>{{end}}</div>{{else}}<div class="article-body">{{.Content}}</div>{{end}}{{if .Attachments}}<section><h2>附件下载</h2>{{range .Attachments}}<a href="{{root $ .URL}}">{{.Name}}</a>{{end}}</section>{{end}}{{if or $.PreviousArticle $.NextArticle}}<nav class="article-pager" aria-label="相邻文章">{{with $.PreviousArticle}}<a href="{{root $ .Href}}?from={{$.ColumnCode}}"><strong>上一篇：</strong>{{.Title}}</a>{{end}}{{with $.NextArticle}}<a href="{{root $ .Href}}?from={{$.ColumnCode}}"><strong>下一篇：</strong>{{.Title}}</a>{{end}}</nav>{{end}}</article>{{end}}</div></div></main>{{template "foot" .}}{{end}}
{{define "empty-detail"}}{{template "head" .}}<main class="page-shell"><div class="page-inner"><section class="article-card"><h1>暂无内容</h1></section></div></main>{{template "foot" .}}{{end}}
