{{define "about"}}{{template "head" .}}<main class="page-shell"><div class="page-inner">{{template "breadcrumb" .}}<div class="content-grid">{{template "sidebar" .}}<section class="article-card">{{with .Article}}<h1>{{.Title}}</h1><div class="article-body">{{.Content}}</div>{{else}}<h1>{{.Title}}</h1><p>暂无公开内容</p>{{end}}</section></div></div></main>{{template "foot" .}}{{end}}
