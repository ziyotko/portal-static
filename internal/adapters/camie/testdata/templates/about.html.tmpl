{{define "about"}}{{template "head" .}}<main class="page-shell"><div class="page-inner">{{template "breadcrumb" .}}<div class="content-grid">{{if ne .ColumnCode "about-english"}}{{template "sidebar" .}}{{end}}<section class="article-card">{{with .Article}}{{if not (or (eq $.ColumnCode "about-introduction") (eq $.ColumnCode "about-organization") (eq $.ColumnCode "about-charter"))}}<h1>{{.Title}}</h1>{{end}}<div class="article-body">{{.Content}}</div>{{else}}{{if not (or (eq $.ColumnCode "about-introduction") (eq $.ColumnCode "about-organization") (eq $.ColumnCode "about-charter"))}}<h1>{{.Title}}</h1>{{end}}<p>{{if eq .ColumnCode "about-english"}}Content coming soon.{{else}}暂无公开内容{{end}}</p>{{end}}</section></div></div></main>{{template "foot" .}}{{end}}
