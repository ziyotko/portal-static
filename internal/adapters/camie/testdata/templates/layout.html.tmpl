{{define "head"}}<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="{{.Title}} - 中国环保机械行业协会"><title>{{.Title}} - 中国环保机械行业协会</title><link rel="stylesheet" href="{{root . "css/common.css"}}">{{if eq .Kind "home"}}<link rel="stylesheet" href="{{root . "css/home.css"}}">{{end}}</head><body class="{{.BodyClass}}" data-root-prefix="{{.RootPrefix}}" data-member-login-path="{{.MemberLoginPath}}" data-static-build="{{.StaticBuildID}}" data-generated-at="{{.StaticGeneratedAt}}">{{if or (eq .Kind "member") (eq .Kind "member-detail")}}<script data-member-auth-gate>(()=>{let token='';try{token=localStorage.getItem('member-token')||''}catch{}if(token)return;const login=new URL(document.body.dataset.memberLoginPath,location.href);login.searchParams.set('returnUrl',location.href);location.replace(login.href)})();</script>{{end}}
<header class="site-header"><div class="header-main"><div class="header-inner"><a class="brand" href="{{root . "index.html"}}"><img src="{{root . "assets/images/brand-logo.png"}}" alt="中国环保机械行业协会 CAMIE"></a><img class="brand-slogan" src="{{root . "assets/images/brand-slogan.png"}}" alt="企业与政府沟通的桥梁"><div class="header-tools"><form class="search-form" action="{{root . "search.html"}}"><input name="q" type="search" placeholder="请输入关键词"><button type="submit">搜索 <span class="search-icon"></span></button></form><button class="language-switch" type="button">中 | EN</button></div><button class="mobile-menu-button" type="button" aria-label="打开导航" aria-expanded="false"><span></span></button></div></div>
<nav class="nav-bar" aria-label="主导航"><div class="nav-inner">
<div class="nav-item {{if eq .ActiveNav "首页"}}active{{end}}"><a class="nav-link" href="{{root . "index.html"}}">首页</a></div>
<div class="nav-item {{if eq .ActiveNav "党建专栏"}}active{{end}}"><a class="nav-link" href="{{columnURL . "party"}}" aria-haspopup="true">党建专栏</a><div class="nav-submenu"><a href="{{columnURL . "party-news"}}">党建要闻</a><a href="{{columnURL . "party-study"}}">学习教育</a><a href="{{columnURL . "party-branch-activity"}}">支部活动</a></div></div>
