</div></nav></header>{{end}}
{{define "breadcrumb"}}<nav class="breadcrumb" aria-label="面包屑" {{if and .Article (ne .Kind "about")}}data-detail-breadcrumb{{else}}data-sync-section="path"{{end}}><ol><li><a href="{{root . "index.html"}}">首页</a></li>{{range .Breadcrumbs}}<li><a href="{{root $ .Href}}">{{.Name}}</a></li>{{end}}{{if eq .Kind "about"}}<li><span aria-current="page">{{if .Article}}{{.Article.Category}}{{else}}{{.Title}}{{end}}</span></li>{{else if .Article}}<li><span aria-current="page">{{.Article.Category}}</span></li>{{else}}<li><span aria-current="page">{{.Title}}</span></li>{{end}}</ol></nav>{{end}}
{{define "sidebar"}}<aside><ul class="side-menu">{{range .Side}}<li class="{{if .Active}}is-active{{end}}">{{if .Children}}<button type="button" aria-expanded="true">{{.Name}} <span class="side-menu-toggle-icon" aria-hidden="true"></span></button><ul class="side-submenu">{{range .Children}}<li class="{{if .Active}}current{{end}}"><a href="{{root $ .Href}}"{{if .Active}} aria-current="page"{{end}}>{{.Name}}</a></li>{{end}}</ul>{{else}}<a href="{{root $ .Href}}"{{if .Active}} aria-current="page"{{end}}>{{.Name}}</a>{{end}}</li>{{end}}</ul></aside>{{end}}
