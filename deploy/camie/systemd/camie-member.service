[Unit]
Description=CAMIE Member API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=camie
Group=camie
WorkingDirectory=/srv/camie/member
EnvironmentFile=/etc/camie/member.env
ExecStart=/opt/camie/current/bin/member
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/camie/member /var/log/camie/member

[Install]
WantedBy=multi-user.target
