<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="机械工业信息中心资讯动态">
  <title>资讯动态 - 机械工业信息中心</title>
  <link rel="icon" type="image/png" href="./assets/miic-favicon.png">
  <link rel="stylesheet" href="./styles.css">
</head>
<body data-page="news" data-generated-at="{{.GeneratedAt}}">
  <header class="site-header" id="site-header"></header>
  <main>
    <section class="home-hero">
      <img class="home-hero__media" src="./assets/home-hero-factory.jpg" alt="工程师查看智能制造机械臂生产线" fetchpriority="high">
      <div class="home-hero__shade"></div>
      <div class="shell home-hero__content">
        <h1>洞察机械工业<br>连接数据与未来</h1>
        <p>聚合行业数据、技术实践与研究成果，为产业发展提供专业、可靠的信息支撑。</p>
        <a class="hero-link" href="#latest">查看最新资讯 <span aria-hidden="true">↗</span></a>
      </div>
      <div class="shell home-hero__facts" aria-label="中心概况">
        <div><strong>1973</strong><span>中心成立</span></div>
        <div><strong>4</strong><span>核心业务板块</span></div>
        <div><strong>14</strong><span>专业服务方向</span></div>
      </div>
    </section>
    <section class="page-content news-content" id="latest">
      <div class="shell">
        <div class="section-heading"><div><h2>资讯动态</h2></div><p>追踪行业变化，分享中心动态与研究观察</p></div>
        <div class="filter-bar" aria-label="资讯分类">
          {{range $index, $category := .Categories}}<button class="{{if eq $index 0}}is-active{{end}}" type="button" data-filter="{{$category.Key}}">{{$category.Title}}</button>{{else}}<span class="static-empty">暂无可用栏目</span>{{end}}
        </div>
        <div class="news-card-grid" id="news-list" data-news-list>
          {{range $item := .Items}}
          <a class="news-card{{if $item.Feature}} news-card--feature{{end}}" data-category="{{$item.CategoryKey}}" href="{{$item.Href}}"{{if $item.External}} target="_blank" rel="noopener noreferrer"{{end}}>
            <figure><img src="{{$item.Cover}}" alt="{{$item.Title}}" loading="lazy"></figure>
            <div class="news-card__body"><div class="news-card__meta"><span>{{$item.Category}}</span><time datetime="{{$item.DateISO}}">{{$item.DateDot}}</time></div><h2>{{$item.Title}}</h2><p>{{$item.Summary}}</p><span class="card-link">阅读全文 <b aria-hidden="true">→</b></span></div>
          </a>
          {{else}}<p class="static-empty">暂无已发布资讯</p>{{end}}
        </div>
        <div class="news-load-more" data-news-load-more><button type="button" aria-controls="news-list">加载更多</button><p aria-live="polite" data-news-count></p></div>
      </div>
    </section>
  </main>
  <footer class="site-footer" id="site-footer"></footer>
  <script src="./generated-content.js"></script>
  <script src="./script.js"></script>
</body>
</html>
